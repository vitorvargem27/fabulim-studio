# Normalizacao de fim de linha: scripts de shell PRECISAM ser LF; .bat/.ps1 ficam CRLF no Windows.
* text=auto
*.sh   text eol=lf
scripts/hooks/* text eol=lf
*.py   text eol=lf
*.ts   text eol=lf
*.tsx  text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.yaml text eol=lf
*.yml  text eol=lf
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# Binarios
*.png  binary
*.jpg  binary
*.svg  text eol=lf
*.mp4  binary
*.wav  binary
*.mp3  binary
