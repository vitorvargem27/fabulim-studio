# Fabulim Studio: configurações opcionais.
# Para usar: copie este arquivo para ".env" (na mesma pasta) e tire o "#" das linhas que quiser mudar; depois reinicie o app.
# O ".env" não vai para o git. Uma variável de ambiente de verdade, se existir, vence o que estiver aqui.
# Só chaves FABULIM_* são lidas. NUNCA coloque chaves de API aqui: a chave do Claude, se você usar, vai para o cofre do sistema.

# Endereço do servidor: só 127.0.0.1 é aceito (nenhuma porta exposta à rede).
# FABULIM_HOST=127.0.0.1
# FABULIM_PORT=8765

# Onde ficam projetos, imagens, clipes, exportações e logs (aponte para um disco com espaço) e os pesos dos modelos.
# FABULIM_DATA_DIR=D:\Fabulim\data
# FABULIM_MODELS_DIR=D:\Fabulim\models

# Ollama local (só esta máquina).
# FABULIM_OLLAMA_URL=http://127.0.0.1:11434

# 0 desativa o diagnóstico automático ao iniciar.
# FABULIM_AUTO_DIAGNOSTICO=1
